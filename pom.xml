<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.yufeng</groupId>
    <artifactId>MyBossPin</artifactId>
    <version>1.0-SNAPSHOT</version>

    <!--
      打包方式:
      1. jar: 打包成jar文件，作用可以是springboot应用、被其他项目引用的jar包等
      2. war: 打包成war文件，作用是部署到web服务器上
      3. pom: 仅作为父项目或聚合项目使用，不会生成任何文件(顶级pom可以管理子项目的版本等)
     -->
    <packaging>pom</packaging>

    <name>MyBossPin</name>
    <url>http://maven.apache.org</url>

    <!--
      hire-common: 通用工程，工具类、枚举类、异常类、常用属性类、资源类等等
      hire-pojo: 所有实体类的管理，pojo、bean、entity、bo、vo、dto 等
      hire-api: web接口（应用）的公用依赖
      service-user: 用户微服务（7001）
      service-company: 企业微服务（6001）
    -->
    <modules>
        <module>common</module>
        <module>model</module>
        <module>api</module>
        <module>ms.user-7001</module>
        <module>ms.company-6001</module>
        <module>ms.gateway-8000</module>
        <module>ms.auth-8111</module> <!--  授权服务  -->
        <module>prac.rabbit-producer</module>
        <module>prac.rabbit-consumer</module>
        <module>ms.resource-4001</module>
        <module>ms.work-3001</module>
        <module>ms.file-5001</module>
        <module>payment-center-9060</module>
    </modules>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.6.11</version>
        <relativePath/>
    </parent>


    <dependencyManagement>
        <dependencies>
            <!-- 引入微服务 spring-cloud-->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>2021.0.4</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 引入微服务组件 spring-cloud-alibaba -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>2021.0.1.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- mysql 驱动 -->
            <dependency>
                <groupId>mysql</groupId>
                <artifactId>mysql-connector-java</artifactId>
                <version>8.0.26</version>
            </dependency>

            <!-- mybatis plus -->
